/*
 * Operand:           Gemm
 * Name in ONNX file: node_linear
 */
FUNC_PREFIX void node_node_linear( const float A[1][64], const float B[10][64], const float C[10], float Y[1][10] )
{
	/* Gemm */
	/* alpha   = 1.00000000000000000000
	   beta    = 1.00000000000000000000
	   transA  = 0
	   transB  = 1
	 */
	const int M = 1;
	const int K = 64;
	const int N = 10;
	float alpha = 1.00000000000000000000;
	float beta = 1.00000000000000000000;
	float (*C_)[10]  = (float(*)[10])C;
	for( uint32_t r=0; r<M; r++ )
		for( uint32_t c=0; c<N; c++ ) {
			float ABrc = 0;
			for( uint32_t i=0; i<K; i++ ) {
				float B_el = B[c][i];
				ABrc += A[r][i] * B_el;
			}
			float tmp = ABrc * alpha;
			tmp += C_[0][c] * beta;
			Y[r][c] = tmp;
	}
}


