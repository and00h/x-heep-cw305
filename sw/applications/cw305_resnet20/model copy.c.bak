/*
 * Operand:           AveragePool
 * Name in ONNX file: node_avg_pool2d
 */
FUNC_PREFIX void node_node_avg_pool2d( const float x[1][64][8][8], float y[1][64][1][1] )
{
	/* AveragePool
	 *
	 * auto_pad: NOTSET
	 * dilations: 1 1 
	 * group: 1
	 * kernel_shape: 8 8 
	 * pads: 0 0 0 0 
	 * strides: 8 8 
	 */
	for( uint32_t b=0; b<1; b++ ) {
	for( uint32_t m=0, c=0; m<64; m++, c=m) {
		for( int32_t o0=0, i0=0; o0<1; o0++, i0+=8) {
		for( int32_t o1=0, i1=0; o1<1; o1++, i1+=8) {
			float curavg = 0.0;
			int numavg = 0;
			for( uint32_t k0=0; k0<8; k0++ ) {
			for( uint32_t k1=0; k1<8; k1++ ) {
				int ii0 = i0+k0 * 1;
				int ii1 = i1+k1 * 1;
				numavg += 1;
				curavg += x[b][c][ii0][ii1];
			} /* k */
			} /* k */
			/* Counting padding into the average is requested */
			numavg = 64;
			y[b][m][o0][o1]= curavg/numavg;
		} /* o */
		} /* o */
	} /* m */
	} /* b */
}

