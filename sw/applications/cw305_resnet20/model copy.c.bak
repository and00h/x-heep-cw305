/*
 * Operand:           Pad
 * Name in ONNX file: node_pad_1
 */
FUNC_PREFIX void node_node_pad_1( const float data[1][32][8][8], const int64_t pads[8], const float *constant_value, float output[1][64][8][8] )
{
	/* Pad: 
	 * pad at start: 0 16 0 0 
	 * pad at end:   0 16 0 0 
	 * mode: constant
	 */
	uint32_t ir0;
	for( uint32_t o0=0, il0=0; o0<1; o0++ ) {
		bool pad_at_0=false;
		if( o0 < 0){
			pad_at_0= true;
		}
		else if( o0 < 1){
			ir0=il0;
			il0++;
		}
		else {
			pad_at_0= true;
		}
		uint32_t ir1;
		for( uint32_t o1=0, il1=0; o1<64; o1++ ) {
			bool pad_at_1=false;
			if( o1 < 16){
				pad_at_1= true;
			}
			else if( o1 < 48){
				ir1=il1;
				il1++;
			}
			else {
				pad_at_1= true;
			}
			uint32_t ir2;
			for( uint32_t o2=0, il2=0; o2<8; o2++ ) {
				bool pad_at_2=false;
				if( o2 < 0){
					pad_at_2= true;
				}
				else if( o2 < 8){
					ir2=il2;
					il2++;
				}
				else {
					pad_at_2= true;
				}
				uint32_t ir3;
				for( uint32_t o3=0, il3=0; o3<8; o3++ ) {
					bool pad_at_3=false;
					if( o3 < 0){
						pad_at_3= true;
					}
					else if( o3 < 8){
						ir3=il3;
						il3++;
					}
					else {
						pad_at_3= true;
					}
	if ( pad_at_0  || pad_at_1 || pad_at_2 || pad_at_3)
		output[o0][o1][o2][o3] = 0.00000000000000000000;
	else
		output[o0][o1][o2][o3]= data[ir0][ir1][ir2][ir3];
				}
			}
		}
	}
}

